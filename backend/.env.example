# Meal Connect - Local Development Configuration
# Copy this file to .env and replace placeholders locally.
# Never commit the real .env file.

DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/meal_connect

# For login, replace this placeholder with a random key of at least 32 bytes.
# Generate a local key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=REPLACE_WITH_LOCAL_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
